---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatePicker from '../components/StatePicker.astro';
import ImageSlot from '../components/ImageSlot.astro';
import TrustStrip from '../components/TrustStrip.astro';
import GuideCard from '../components/GuideCard.astro';
import AdSlot from '../components/AdSlot.astro';
import PersonPhoto from '../components/PersonPhoto.astro';
import SmartLink from '../components/SmartLink.astro';
import { slugify } from '../data/states';
import home from '../content/home.json';
import { formatAnnual, formatHourly, getPayData, releaseName } from '../lib/pay';

const professions = await getCollection('professions');
const featured = await getEntry('professions', home.featuredProfession);
if (!featured) throw new Error(`Featured profession "${home.featuredProfession}" was not found.`);
const profession = featured.data;
const professionSlug = featured.id;

// Pay comes from the wage survey; jobs and growth from the Occupational
// Outlook Handbook. Each figure carries a short label naming its source.
const pay = getPayData(professionSlug);
const surveyTag = `Wage survey, ${pay.release.referencePeriod}`;
const outlookTag = 'Occupational Outlook Handbook';
const figures = [
  { label: 'Median pay per year', value: formatAnnual(pay.national.annual.median), source: surveyTag },
  { label: 'Median pay per hour', value: formatHourly(pay.national.hourly.median), source: surveyTag },
  { ...profession.outlook.jobs, source: outlookTag },
  { ...profession.outlook.growth, source: outlookTag },
];
---

<BaseLayout title={home.title} description={home.description}>
  <main id="main" tabindex="-1">
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__text">
          <h1 class="hero__title">{home.hero.heading}</h1>
          <p class="hero__intro">{home.hero.intro}</p>
          <div class="hero__picker">
            <StatePicker
              id="hero"
              professions={professions.map((p) => ({ slug: p.id, name: p.data.name }))}
            />
          </div>
          <p class="note">{home.hero.pickerNote}</p>
        </div>
        <ImageSlot class="hero__image" {...home.hero.image} eager />
      </div>
    </section>

    <TrustStrip items={home.trust} />

    <section class="featured" aria-labelledby="featured-title">
      <div class="container featured__inner">
        <div class="featured__intro">
          <p class="eyebrow">{profession.featured.eyebrow}</p>
          <h2 id="featured-title" class="featured__title">{profession.featured.heading}</h2>
          <p class="featured__lead">{profession.featured.intro}</p>
        </div>
        <div class="featured__panel">
          <dl class="figures">
            {
              figures.map((figure) => (
                <div class="figures__item">
                  <dt>{figure.label}</dt>
                  <dd>
                    <span class="figures__value">{figure.value}</span>
                    <span class="figures__source">{figure.source}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="note">
            Pay: {pay.release.publisher}, {releaseName(pay)}. Jobs and growth: {profession.outlook.source}.
          </p>
          <ul class="cards">
            {profession.guideCards.map((card) => <li><GuideCard {...card} /></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="coming" aria-labelledby="coming-title">
      <div class="container coming__inner">
        <h2 id="coming-title" class="coming__title">{home.comingSoon.heading}</h2>
        <ul class="chips">
          {home.comingSoon.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="coming__note">{home.comingSoon.note}</p>
      </div>
    </section>

    <div class="container banner-ad">
      <AdSlot size="banner" id="home-banner-1" />
    </div>

    <section class="states" aria-labelledby="states-title">
      <div class="container states__inner">
        <h2 id="states-title" class="block-title">{profession.stateGrid.heading}</h2>
        <p class="states__intro">{profession.stateGrid.intro}</p>
        <ul class="states__grid">
          {
            profession.stateGrid.states.map((state) => (
              <li>
                <SmartLink href={`/${professionSlug}/${slugify(state)}/`}>{state}</SmartLink>
              </li>
            ))
          }
          <li>
            <SmartLink class="states__all" href={profession.stateGrid.allStates.href}>
              {profession.stateGrid.allStates.label}
            </SmartLink>
          </li>
        </ul>
      </div>
    </section>

    <div class="container more">
      <section class="popular" aria-labelledby="popular-title">
        <h2 id="popular-title" class="block-title">Popular guides</h2>
        <ul class="popular__list">
          {profession.popularGuides.map((guide) => <li><SmartLink href={guide.href}>{guide.label}</SmartLink></li>)}
        </ul>
      </section>

      <section class="panel panel--tint stack facts" aria-labelledby="facts-title">
        <h2 id="facts-title" class="facts__title">{home.factCheck.heading}</h2>
        <p class="facts__text">{home.factCheck.text}</p>
        <div class="facts__reviewer">
          <PersonPhoto name={home.factCheck.reviewer} size={48} />
          <span>Reviewed by {home.factCheck.reviewer}</span>
        </div>
        <SmartLink class="facts__link" href={home.factCheck.link.href}>{home.factCheck.link.label}</SmartLink>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  main:focus {
    outline: none;
  }

  /* Hero */
  .hero {
    background: var(--color-tint);
  }

  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-10);
  }

  .hero__text {
    flex: 1 1 540px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.3rem + 3.2vw, 3rem);
    line-height: 1.1;
  }

  .hero__intro {
    max-width: 600px;
    font-size: var(--text-lead);
    color: var(--color-text-secondary);
  }

  .hero__picker {
    padding: 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .hero :global(.hero__image) {
    flex: 1 1 320px;
    min-width: 0;
    max-height: 360px;
    border-radius: var(--radius-xl);
  }

  /* Featured profession */
  .featured__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-10) var(--space-7);
  }

  .featured__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }

  .featured__title {
    font-size: 2rem;
  }

  .featured__lead {
    max-width: 680px;
    font-size: 1.05rem;
    color: var(--color-text-secondary);
  }

  .featured__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-7);
    background: var(--color-tint);
    border-radius: var(--radius-xl);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-6);
    margin: 0;
  }

  .figures__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .figures dt {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .figures dd {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .figures__value {
    font-size: 1.9rem;
    font-weight: var(--weight-black);
    line-height: 1.2;
  }

  .figures__source {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .featured__panel > .note {
    margin-top: calc(-1 * var(--space-3));
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
    list-style: none;
    padding: 0;
  }

  .cards li {
    display: flex;
  }

  .cards li > :global(*) {
    flex: 1;
  }

  /* More professions */
  .coming__inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: var(--space-4) var(--space-8);
  }

  .coming__title {
    font-size: 1.3rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
  }

  .chips li {
    padding: 10px var(--space-4);
    font-size: var(--text-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  .coming__note {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .banner-ad {
    padding-bottom: var(--space-9);
  }

  /* State grid */
  .states {
    background: var(--color-light);
  }

  .states__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-9);
  }

  .block-title {
    font-size: 1.75rem;
  }

  .states__intro {
    color: var(--color-text-secondary);
  }

  .states__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: var(--space-1) var(--space-5);
    list-style: none;
    padding: 0;
  }

  .states__grid :is(a, .link-pending) {
    display: flex;
    align-items: center;
    min-height: 48px;
  }

  .states__all {
    font-weight: var(--weight-bold);
  }

  /* Popular guides and fact checking */
  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-9) var(--space-10);
  }

  .popular {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .popular__list {
    list-style: none;
    padding: 0;
    font-size: var(--text-lg);
  }

  .popular__list li {
    border-bottom: 1px solid var(--color-border);
  }

  .popular__list :is(a, .link-pending) {
    display: block;
    padding: 14px 0;
  }

  .facts {
    padding: var(--space-7);
  }

  .facts__title {
    font-size: 1.4rem;
  }

  .facts__text {
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .facts__reviewer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-md);
  }

  .facts__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
  }

  @media (max-width: 480px) {
    .hero__inner {
      padding-block: var(--space-8);
    }

    .featured__panel,
    .facts {
      padding: var(--space-5);
    }
  }
</style>
