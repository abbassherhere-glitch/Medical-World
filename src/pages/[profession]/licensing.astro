---
/** Licensing by state for a profession, for example /dental-hygienist/licensing/. */
import { getCollection, getEntry } from 'astro:content';
import TopicPage from '../../components/TopicPage.astro';
import { isLive } from '../../data/routes';

export async function getStaticPaths() {
  const pages = await getCollection('topicPages');
  return pages.map((page) => ({ params: { profession: page.data.profession.id }, props: { page: page.data } }));
}

const { page } = Astro.props;
const slug = page.profession.id;
const profession = await getEntry(page.profession);

// The five steps in short form, each linking to its full step on "How to become one".
const become = (await getCollection('becomeGuides')).find((g) => g.data.profession.id === slug);
const becomeHref = `/${slug}/how-to-become/`;
const linkSteps = become !== undefined && (await isLive(becomeHref));
const steps = become?.data.steps ?? [];
---

<TopicPage
  slug={slug}
  profession={profession.data}
  byline={page.byline}
  activeMenu="licensing"
  topic={page.licensing}
  section="licensing"
  related={page.related}
  pickerHeading="Licensing rules in your state"
>
  {
    steps.length > 0 && (
      <section class="panel stack" aria-labelledby="steps">
        <h2 id="steps" class="section-title">The usual steps</h2>
        <ol class="steps">
          {steps.map((step) => (
            <li>{linkSteps ? <a href={`${becomeHref}#${step.id}`}>{step.title}</a> : step.title}</li>
          ))}
        </ol>
        {linkSteps && <a class="more-link" href={becomeHref}>Read the full guide: {become!.data.heading}</a>}
      </section>
    )
  }
</TopicPage>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-6);
  }

  .steps a,
  .more-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
  }

  .more-link {
    font-weight: var(--weight-bold);
  }
</style>
