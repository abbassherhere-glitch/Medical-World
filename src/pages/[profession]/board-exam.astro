---
/** The national board exam for a profession, for example /dental-hygienist/board-exam/. */
import { getCollection, getEntry } from 'astro:content';
import TopicPage from '../../components/TopicPage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('topicPages');
  return pages.map((page) => ({ params: { profession: page.data.profession.id }, props: { page: page.data } }));
}

const { page } = Astro.props;
const profession = await getEntry(page.profession);
---

<TopicPage
  slug={page.profession.id}
  profession={profession.data}
  byline={page.byline}
  activeMenu="exam"
  topic={page.boardExam}
  section="licensing"
  related={page.related}
  pickerHeading="Clinical exam rules in your state"
>
  <section class="panel stack" aria-labelledby="exam-facts">
    <h2 id="exam-facts" class="section-title">About the exam</h2>
    <dl class="facts">
      {
        page.boardExam.facts.map((fact) => (
          <div class="facts__row">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</TopicPage>

<style>
  .facts {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .facts__row {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) 3fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
  }

  .facts__row:first-child {
    border-top: 0;
  }

  dt {
    font-weight: var(--weight-bold);
  }

  dd {
    margin: 0;
  }

  @media (max-width: 480px) {
    .facts__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
