---
/** National salary guide for a profession, for example /dental-hygienist/salary/. */
import { getCollection, getEntry } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StatGrid from '../../components/StatGrid.astro';
import PayRangeBar from '../../components/PayRangeBar.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import PayByStateTable from '../../components/PayByStateTable.astro';
import PayPeriodsTable from '../../components/PayPeriodsTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import FaqList from '../../components/FaqList.astro';
import SourcesBox from '../../components/SourcesBox.astro';
import SourceLine from '../../components/SourceLine.astro';
import StatePicker from '../../components/StatePicker.astro';
import LinkPanel from '../../components/LinkPanel.astro';
import {
  formatAnnual,
  formatHourly,
  formatJobs,
  getPayData,
  releaseName,
  statesAndDc,
  surveyPhrase,
} from '../../lib/pay';
import { capitalize, highestAndLowest, joinNames, medianInWords, rankByMedian } from '../../lib/pay/summary';
import { inlineMarkup } from '../../lib/text';

export async function getStaticPaths() {
  const guides = await getCollection('salaryGuides');
  return guides.map((guide) => ({
    params: { profession: guide.data.profession.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const data = guide.data;
const profession = await getEntry(data.profession);
const professionSlug = data.profession.id;
const plural = profession.data.namePlural;

const pay = getPayData(professionSlug);
const national = pay.national;
const release = releaseName(pay);
const states = statesAndDc(pay);
const extremes = highestAndLowest(states);
const survey = surveyPhrase(pay);
// The District of Columbia is listed with the states but is not one.
const topState = rankByMedian(states.filter((s) => s.kind === 'state'))[0];

const median = medianInWords(national);
const summary = `${capitalize(plural)} in the US earn a median of **${median}**, according to ${survey}.`;

const listRanked = (items: { name: string; median: number }[]) =>
  `${joinNames(items.map((s) => s.name))} (${formatAnnual(items[0]!.median)})`;

const takeaways = [
  `The national median pay is ${median} (${release}).`,
  ...(extremes
    ? [
        `By median yearly pay, the highest pay is in ${listRanked(extremes.highest)}${
          topState && !extremes.highest.some((s) => s.name === topState.name)
            ? `, and the highest of the states themselves is ${topState.name} (${formatAnnual(topState.median)})`
            : ''
        }. The lowest is in ${listRanked(extremes.lowest)} (${release}).`,
      ]
    : []),
  ...data.outlookTakeaways,
];

const answers: Record<string, string> = {
  'hourly-median': `The national median is ${formatHourly(national.hourly.median)} an hour, or ${formatAnnual(national.annual.median)} a year, according to ${survey}. Half of ${plural} earn more than this and half earn less.`,
  'highest-state': extremes
    ? [
        `${capitalize(joinNames(extremes.highest.map((s) => s.name)))} ${extremes.highest.length > 1 ? 'have' : 'has'} the highest median pay, at ${formatAnnual(extremes.highest[0]!.median)} a year, according to ${survey}.`,
        topState && !extremes.highest.some((s) => s.name === topState.name)
          ? `Of the states themselves, ${topState.name} is highest, at ${formatAnnual(topState.median)}.`
          : '',
        `The national median is ${formatAnnual(national.annual.median)}.`,
      ]
        .filter(Boolean)
        .join(' ')
    : 'State figures are not available.',
  'lower-pay': `The wage survey does not report starting pay. As a guide to pay at the lower end, the lowest-paid 10% of ${plural} earned less than ${formatAnnual(national.annual.p10)} a year (${formatHourly(national.hourly.p10)} an hour), and the lowest-paid 25% earned less than ${formatAnnual(national.annual.p25)} a year, according to ${survey}.`,
};
const faqs = data.faqs.map((faq) => ({
  question: faq.question,
  answer: faq.answerFrom ? answers[faq.answerFrom]! : (faq.answer ?? ''),
}));

const sources = [`${pay.release.publisher}, ${release}`, ...data.otherSources];

const contents = [
  { label: 'Pay per hour, week, month and year', id: 'pay-periods' },
  { label: data.payByState.heading, id: 'pay-by-state' },
  { label: data.factors.heading, id: 'what-affects-pay' },
  { label: 'Common questions', id: 'common-questions' },
  { label: 'Sources', id: 'sources' },
];
---

<GuideLayout
  title={data.title}
  description={data.description}
  heading={data.heading}
  profession={profession.data}
  activeMenu="salary"
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: profession.data.name, href: `/${professionSlug}/` },
    { label: data.breadcrumb },
  ]}
  byline={data.byline}
>
  <section class="panel panel--tint stack summary" aria-label="Summary">
    <p class="summary__lead" set:html={inlineMarkup(summary)} />
    <StatGrid
      items={[
        { label: 'Median per year', value: formatAnnual(national.annual.median) },
        { label: 'Median per hour', value: formatHourly(national.hourly.median) },
        { label: 'Jobs counted in the survey', value: formatJobs(national.employment) },
      ]}
    />
    <PayRangeBar annual={national.annual} />
    <SourceLine data={pay} />
  </section>

  <KeyTakeaways items={takeaways} />
  <PayPeriodsTable id="pay-periods" place="the United States" figures={national} source={`${pay.release.publisher}, ${release}`} />
  <TableOfContents items={contents} />
  <ImageSlot {...data.image} />

  <section class="stack" aria-labelledby="pay-by-state">
    <h2 id="pay-by-state" class="section-title">{data.payByState.heading}</h2>
    <p class="muted">{data.payByState.intro}</p>
    <PayByStateTable profession={professionSlug} name={profession.data.name} plural={plural} />
  </section>

  <AdSlot size="inline" id="salary-content-1" />

  <section class="stack" aria-labelledby="what-affects-pay">
    <h2 id="what-affects-pay" class="section-title">{data.factors.heading}</h2>
    <ul class="factor-list">
      {data.factors.items.map((item) => <li><strong>{item.title}</strong> {item.text}</li>)}
    </ul>
  </section>

  <FaqList id="common-questions" heading="Common questions" items={faqs} />
  <SourcesBox items={sources} />

  <Fragment slot="aside">
    <section class="panel panel--highlight stack" aria-labelledby="find-schools">
      <h2 id="find-schools" class="panel-title">{data.schoolFinder.heading}</h2>
      <StatePicker id="side" profession={professionSlug} layout="column" section="schools" />
      <p class="note">{data.schoolFinder.note}</p>
    </section>
    <AdSlot size="sidebar" id="salary-side-1" />
    <LinkPanel heading="Related guides" links={data.related} />
  </Fragment>
</GuideLayout>

<style>
  .summary {
    --stack-gap: 18px;
    padding: var(--space-7);
  }

  .summary__lead {
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .muted {
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .strong {
    font-weight: var(--weight-bold);
  }

  .factor-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 22px;
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .summary {
      padding: var(--space-5);
    }
  }
</style>
