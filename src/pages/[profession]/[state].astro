---
/** State guide for a profession, for example /dental-hygienist/texas/. */
import { getCollection, getEntry } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StatGrid from '../../components/StatGrid.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import ScrollTable from '../../components/ScrollTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import SourcesBox from '../../components/SourcesBox.astro';
import LinkPanel from '../../components/LinkPanel.astro';
import SmartLink from '../../components/SmartLink.astro';
import SourceLine from '../../components/SourceLine.astro';
import PayPeriodsTable from '../../components/PayPeriodsTable.astro';
import CalculatorLink from '../../components/CalculatorLink.astro';
import {
  areasInState,
  byMedianDescending,
  findState,
  formatAnnual,
  formatHourly,
  formatJobs,
  formatPercent,
  getPayData,
  numeric,
  releaseName,
  statesAndDc,
  surveyPhrase,
} from '../../lib/pay';
import { areaSummary, capitalize, ordinal, compareWithNational, placeName, rankByMedian, rankInWords, rankOf } from '../../lib/pay/summary';
import { fillState } from '../../lib/publishing';
import { getPublishedStatePages } from '../../data/state-pages';
import { bordersOf } from '../../data/borders';
import { slugify } from '../../data/states';

export async function getStaticPaths() {
  const [templates, pages] = await Promise.all([getCollection('stateGuides'), getPublishedStatePages()]);
  return pages.flatMap((page) => {
    const template = templates.find((t) => t.data.profession.id === page.profession);
    if (!template) return [];
    return [{ params: { profession: page.profession, state: page.slug }, props: { template: template.data, state: page.state } }];
  });
}

const { template, state } = Astro.props;
// The template's text with {state} filled in; "the District of Columbia" reads naturally in sentences.
const where = placeName(state);
const data = fillState(template, where);
const profession = await getEntry(data.profession);
const professionSlug = data.profession.id;
const plural = profession.data.namePlural;
const stateHref = (name: string) => `/${professionSlug}/${slugify(name)}/`;

// Everything below is worked out from the pay data, so each page says
// something specific to its state.
const pay = getPayData(professionSlug);
const release = releaseName(pay);
const survey = surveyPhrase(pay);
const national = pay.national;
const statePay = findState(pay, state);
if (!statePay) throw new Error(`"${state}" is not in the pay data.`);
const local = statePay.figures;
const allStates = statesAndDc(pay);
const rank = rankOf(allStates, state);
const comparison =
  compareWithNational(state, local, national) ??
  `The ${pay.release.referencePeriod} survey has no statewide pay figures for ${plural} in ${where}.`;
const areas = areasInState(pay, statePay.abbr);
const areaSentence = areaSummary(state, areas);
const areaMedians = areas.map((a) => numeric(a.figures.annual.median)).filter((m): m is number => m !== undefined);

const rankSentence = rank
  ? `${capitalize(where)} ranks ${rankInWords(rank)} by median pay, among the states and DC with published figures.`
  : `${capitalize(where)} is not ranked, because the survey has no statewide median for it.`;
const jobs = numeric(local?.employment);
const low = numeric(local?.annual.p10);
const high = numeric(local?.annual.p90);
const rangeSentence =
  low !== undefined && high !== undefined
    ? `${jobs !== undefined ? `The survey counts ${formatJobs(jobs)} ${plural} in ${where}. ` : ''}The lowest-paid 10% earn less than ${formatAnnual(low)} a year and the top 10% earn more than ${formatAnnual(high)}.`
    : undefined;

const takeaways = [
  `${comparison.replace(/\.$/, '')} (${release}).`,
  rankSentence,
  ...(rangeSentence ? [rangeSentence] : []),
  areaSentence,
  ...data.takeaways,
];

// Nearby states: bordering states with their medians. Alaska and Hawaii
// border no state, so they are compared with the national figure and the
// highest paying states instead.
const neighbors = byMedianDescending(bordersOf(statePay.abbr).map((abbr) => allStates.find((s) => s.abbr === abbr)!));
const topStates = rankByMedian(allStates)
  .filter((s) => s.name !== state)
  .slice(0, 3)
  .map((r) => allStates.find((s) => s.name === r.name)!);
const compareRows = neighbors.length > 0 ? neighbors : topStates;
const compareHeading = neighbors.length > 0 ? 'Pay in nearby states' : `How ${where} compares`;
const compareIntro =
  neighbors.length > 0
    ? `Median pay in the states that border ${where}.`
    : `${capitalize(where)} borders no other state, so here it is compared with the national figure and the highest paying states.`;

// Title and description include the state and a real figure from the data.
const stateMedian = numeric(local?.annual.median);
const usMedian = numeric(national.annual.median);
let title: string;
let description: string;
if (stateMedian !== undefined) {
  const diff = usMedian !== undefined ? (stateMedian - usMedian) / usMedian : undefined;
  title = `Dental hygienist pay in ${where}: ${formatAnnual(stateMedian)} median, license and schools`;
  description = `${capitalize(plural)} in ${where} earn a median of ${formatAnnual(stateMedian)} a year (${formatHourly(local?.hourly.median)} an hour)${
    diff !== undefined && diff !== 0 ? `, ${formatPercent(diff)} ${diff > 0 ? 'above' : 'below'} the US median` : ''
  }. Pay by area, licensing steps and schools.`;
} else if (areaMedians.length > 0) {
  const [min, max] = [Math.min(...areaMedians), Math.max(...areaMedians)];
  title = `Dental hygienist pay in ${where}: area medians ${formatAnnual(min)} to ${formatAnnual(max)}`;
  description = `There is no statewide median for ${plural} in ${where} in ${survey}, but area medians run from ${formatAnnual(min)} to ${formatAnnual(max)} a year. Licensing steps and schools.`;
} else {
  title = `Dental hygienist pay in ${where}: license and schools`;
  description = `${capitalize(plural)} in ${where}: the US median is ${formatAnnual(usMedian)} a year. Licensing steps and schools.`;
}

const sources = [`${pay.release.publisher}, ${release}`, ...data.otherSources];

const contents = [
  { label: data.pay.heading, id: 'pay' },
  ...(local ? [{ label: 'Pay per hour, week, month and year', id: 'pay-periods' }] : []),
  { label: data.cityPay.heading, id: 'pay-by-city' },
  { label: compareHeading, id: 'nearby' },
  { label: data.licensing.heading, id: 'licensing' },
  { label: data.schools.heading, id: 'schools' },
];
---

<GuideLayout
  title={title}
  description={description}
  heading={data.heading}
  profession={profession.data}
  activeMenu=""
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: profession.data.name, href: `/${professionSlug}/` },
    { label: state },
  ]}
  byline={data.byline}
>
  <KeyTakeaways items={takeaways} />
  <TableOfContents items={contents} />

  <section class="panel panel--tint stack pay" aria-labelledby="pay">
    <h2 id="pay" class="section-title">{data.pay.heading}</h2>
    <StatGrid
      size="small"
      items={[
        { label: `${state}, median per year`, value: formatAnnual(local?.annual.median) },
        { label: `${state}, median per hour`, value: formatHourly(local?.hourly.median) },
        { label: 'US, median per year', value: formatAnnual(national.annual.median) },
        { label: 'US, median per hour', value: formatHourly(national.hourly.median) },
        { label: 'Rank by median pay', value: rank ? `${ordinal(rank.rank)} of ${rank.of}` : 'Not ranked' },
        { label: `Jobs in ${state}`, value: formatJobs(local?.employment) },
        { label: 'Lowest 10% earn less than', value: formatAnnual(local?.annual.p10) },
        { label: 'Top 10% earn more than', value: formatAnnual(local?.annual.p90) },
      ]}
    />
    <p class="pay__summary">{comparison} {rankSentence}</p>
    <SourceLine data={pay} />
  </section>

  {local && <PayPeriodsTable id="pay-periods" place={where} figures={local} source={`${pay.release.publisher}, ${release}`} />}

  <ImageSlot {...data.image} />

  <section class="stack" aria-labelledby="pay-by-city">
    <h2 id="pay-by-city" class="section-title">{data.cityPay.heading}</h2>
    <p class="muted">{data.cityPay.intro}</p>
    {
      areas.length > 0 ? (
        <ScrollTable
          caption={`${profession.data.name} pay by area in ${where}, highest median first`}
          columns={['Area', 'Median per year', 'Median per hour', 'Jobs']}
          minWidth={560}
        >
          {areas.map((area) => (
            <tr>
              <th scope="row">{area.name}</th>
              <td class="strong">{formatAnnual(area.figures.annual.median)}</td>
              <td>{formatHourly(area.figures.hourly.median)}</td>
              <td>{formatJobs(area.figures.employment)}</td>
            </tr>
          ))}
        </ScrollTable>
      ) : null
    }
    <p>{areaSentence}</p>
    <p class="note">Source: {pay.release.publisher}, {release}.</p>
  </section>

  <section class="stack" aria-labelledby="nearby">
    <h2 id="nearby" class="section-title">{compareHeading}</h2>
    <p class="muted">{compareIntro}</p>
    <ScrollTable caption={compareHeading} columns={['Place', 'Median per year', 'Median per hour', 'Compared with ' + where]} minWidth={560}>
      <tr class="own-row">
        <th scope="row">{state} (this page)</th>
        <td class="strong">{formatAnnual(local?.annual.median)}</td>
        <td>{formatHourly(local?.hourly.median)}</td>
        <td>–</td>
      </tr>
      {
        compareRows.map((other) => {
          const theirs = numeric(other.figures?.annual.median);
          const diff = theirs !== undefined && stateMedian !== undefined ? theirs - stateMedian : undefined;
          return (
            <tr>
              <th scope="row">
                <SmartLink href={stateHref(other.name)}>{other.name}</SmartLink>
              </th>
              <td>{formatAnnual(other.figures?.annual.median)}</td>
              <td>{formatHourly(other.figures?.hourly.median)}</td>
              <td>{diff === undefined ? 'Not available' : diff === 0 ? 'Same' : `${formatAnnual(Math.abs(diff))} ${diff > 0 ? 'higher' : 'lower'}`}</td>
            </tr>
          );
        })
      }
      {
        neighbors.length === 0 && (
          <tr>
            <th scope="row">United States</th>
            <td>{formatAnnual(national.annual.median)}</td>
            <td>{formatHourly(national.hourly.median)}</td>
            <td>
              {stateMedian !== undefined && usMedian !== undefined
                ? `${formatAnnual(Math.abs(usMedian - stateMedian))} ${usMedian > stateMedian ? 'higher' : 'lower'}`
                : 'Not available'}
            </td>
          </tr>
        )
      }
    </ScrollTable>
    <p class="note">Yearly and hourly medians. Source: {pay.release.publisher}, {release}.</p>
  </section>

  <AdSlot size="inline" id="state-content-1" />

  <section class="stack licensing" aria-labelledby="licensing">
    <h2 id="licensing" class="section-title">{data.licensing.heading}</h2>
    <p class="muted">{data.licensing.intro}</p>
    <ol class="steps">
      {
        data.licensing.steps.map((step) => (
          <li>
            <strong>{step.title}</strong> {step.text}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="stack" aria-labelledby="schools">
    <h2 id="schools" class="section-title" tabindex="-1">{data.schools.heading}</h2>
    <ScrollTable caption={data.schools.heading} columns={data.schools.columns} minWidth={560}>
      {
        data.schools.rows.map((school) => (
          <tr>
            <th scope="row">
              {school.href ? <SmartLink href={school.href}>{school.name}</SmartLink> : school.name}
              {school.sponsored && <span class="sponsored">Sponsored</span>}
            </th>
            <td>{school.city}</td>
            <td>{school.award}</td>
            <td>{school.length}</td>
          </tr>
        ))
      }
    </ScrollTable>
    <p class="note">{data.schools.note}</p>
  </section>

  <SourcesBox items={sources} />

  <Fragment slot="aside">
    <section class="panel panel--highlight stack" aria-labelledby="compare">
      <h2 id="compare" class="panel-title">{data.compare.heading}</h2>
      <p class="muted">{data.compare.text}</p>
      <a class="button button--action" href={data.compare.button.href}>{data.compare.button.label}</a>
      <p class="note">{data.compare.note}</p>
    </section>
    <CalculatorLink
      profession={professionSlug}
      state={slugify(state)}
      heading="Pay calculator"
      text={`See pay in ${where} per hour, week, month or year, and compare it with another state.`}
      label={`Compare ${state}`}
    />
    <AdSlot size="sidebar" id="state-side-1" />
    {
      neighbors.length > 0 && (
        <LinkPanel heading="Nearby states" links={neighbors.map((n) => ({ label: n.name, href: stateHref(n.name) }))} />
      )
    }
    <LinkPanel heading="National guides" links={data.nationalGuides} />
  </Fragment>
</GuideLayout>

<style>
  .pay {
    --stack-gap: 18px;
    padding: var(--space-7);
  }

  .pay__summary {
    line-height: 1.6;
  }

  .strong {
    font-weight: var(--weight-bold);
  }

  .own-row {
    background: var(--color-tint);
  }

  .muted {
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .licensing {
    --stack-gap: 14px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: var(--space-6);
    line-height: 1.6;
  }

  .sponsored {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 2px 8px;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    background: var(--color-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    vertical-align: middle;
  }

  @media (max-width: 480px) {
    .pay {
      padding: var(--space-5);
    }
  }
</style>
