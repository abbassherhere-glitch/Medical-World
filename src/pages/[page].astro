---
/** Standard pages written in Markdown in src/content/pages/, for example /about/. */
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import FillSettings from '../components/FillSettings.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<PageLayout
  title={page.data.title}
  description={page.data.description}
  heading={page.data.heading}
  lastUpdated={page.data.lastUpdated}
>
  <FillSettings><Content /></FillSettings>
</PageLayout>
