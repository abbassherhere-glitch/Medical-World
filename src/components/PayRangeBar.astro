---
/**
 * Pay range bar: lowest 10%, median and top 10% of yearly pay.
 * The median marker sits in proportion between the 10th and 90th
 * percentiles. If any of the three is not published, the marker is left out
 * rather than placed by guesswork.
 */
import { formatAnnual, numeric } from '../lib/pay';
import type { PayPercentiles } from '../lib/pay/types';

interface Props {
  annual: PayPercentiles;
}

const { annual } = Astro.props;
const [low, mid, high] = [numeric(annual.p10), numeric(annual.median), numeric(annual.p90)];
const position =
  low !== undefined && mid !== undefined && high !== undefined && high > low
    ? Math.min(100, Math.max(0, ((mid - low) / (high - low)) * 100))
    : undefined;
---

<div class="pay-range">
  <h3 class="pay-range__title">Yearly pay range</h3>
  <div class="pay-range__bar" aria-hidden="true">
    {position !== undefined && <span class="pay-range__marker" style={`left: ${position.toFixed(1)}%`} />}
  </div>
  <dl class="pay-range__labels">
    <div><dt>Lowest 10% earn less than</dt> <dd>{formatAnnual(annual.p10)}</dd></div>
    <div class="pay-range__median"><dt>Median:</dt> <dd>{formatAnnual(annual.median)}</dd></div>
    <div><dt>Top 10% earn more than</dt> <dd>{formatAnnual(annual.p90)}</dd></div>
  </dl>
</div>

<style>
  .pay-range {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .pay-range__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .pay-range__bar {
    position: relative;
    height: 12px;
    border-radius: var(--radius-pill);
    background: var(--color-tint-strong);
  }

  .pay-range__marker {
    position: absolute;
    top: -4px;
    width: 4px;
    height: 20px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .pay-range__labels {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px var(--space-4);
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .pay-range__labels dt,
  .pay-range__labels dd {
    display: inline;
    margin: 0;
  }

  .pay-range__median {
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
</style>
