---
/**
 * Pay range bar: lowest 10%, median and top 10%.
 * The median marker sits at the median's position between the two ends once
 * all three are real numbers, and in the middle while any is a placeholder.
 */
interface Props {
  low: string;
  median: string;
  high: string;
}

const { low, median, high } = Astro.props;

const toNumber = (value: string) => {
  const n = Number(value.replace(/[^0-9.]/g, ''));
  return /\d/.test(value) && !value.includes('[') ? n : NaN;
};
const [l, m, h] = [toNumber(low), toNumber(median), toNumber(high)];
const position = [l, m, h].every(Number.isFinite) && h > l ? ((m - l) / (h - l)) * 100 : 50;
---

<div class="pay-range">
  <h3 class="pay-range__title">Pay range</h3>
  <div class="pay-range__bar" aria-hidden="true">
    <span class="pay-range__marker" style={`left: ${position.toFixed(1)}%`}></span>
  </div>
  <dl class="pay-range__labels">
    <div><dt>Lowest 10%:</dt> <dd>{low}</dd></div>
    <div class="pay-range__median"><dt>Median:</dt> <dd>{median}</dd></div>
    <div><dt>Top 10%:</dt> <dd>{high}</dd></div>
  </dl>
</div>

<style>
  .pay-range {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .pay-range__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .pay-range__bar {
    position: relative;
    height: 12px;
    border-radius: var(--radius-pill);
    background: var(--color-tint-strong);
  }

  .pay-range__marker {
    position: absolute;
    top: -4px;
    width: 4px;
    height: 20px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .pay-range__labels {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px var(--space-4);
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .pay-range__labels dt,
  .pay-range__labels dd {
    display: inline;
    margin: 0;
  }

  .pay-range__median {
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
</style>
