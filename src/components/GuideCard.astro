---
import Icon, { type IconName } from './Icon.astro';
import { isLive } from '../data/routes';

interface Props {
  icon: IconName;
  title: string;
  text: string;
  linkText: string;
  href: string;
}

const { icon, title, text, linkText, href } = Astro.props;
// Until the guide is published, the card shows without a link or call to action.
const live = await isLive(href);
const Tag = live ? 'a' : 'div';
---

<Tag class="guide-card" href={live ? href : undefined}>
  <Icon name={icon} />
  <span class="guide-card__title">{title}</span>
  <span class="guide-card__text">{text}</span>
  {live && <span class="guide-card__link">{linkText}</span>}
</Tag>

<style>
  .guide-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  a.guide-card:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  a.guide-card:hover .guide-card__link {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .guide-card__title {
    font-size: 1.15rem;
    font-weight: var(--weight-black);
  }

  .guide-card__text {
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .guide-card__link {
    margin-top: auto;
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }
</style>
