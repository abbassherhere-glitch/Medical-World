---
/**
 * The four national figures for a profession. Pay comes from the wage
 * survey; jobs and growth from the Occupational Outlook Handbook. Each figure
 * carries a short label naming its source, and the two are never mixed.
 */
import { formatAnnual, formatHourly, getPayData, releaseName } from '../lib/pay';

interface Props {
  profession: string;
  outlook: { source: string; jobs: { label: string; value: string }; growth: { label: string; value: string } };
}

const { profession, outlook } = Astro.props;
const pay = getPayData(profession);
const surveyTag = `Wage survey, ${pay.release.referencePeriod}`;
const outlookTag = 'Occupational Outlook Handbook';
const figures = [
  { label: 'Median pay per year', value: formatAnnual(pay.national.annual.median), source: surveyTag },
  { label: 'Median pay per hour', value: formatHourly(pay.national.hourly.median), source: surveyTag },
  { ...outlook.jobs, source: outlookTag },
  { ...outlook.growth, source: outlookTag },
];
---

<div class="national-figures">
  <dl class="figures">
    {
      figures.map((figure) => (
        <div class="figures__item">
          <dt>{figure.label}</dt>
          <dd>
            <span class="figures__value">{figure.value}</span>
            <span class="figures__source">{figure.source}</span>
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="note">Pay: {pay.release.publisher}, {releaseName(pay)}. Jobs and growth: {outlook.source}.</p>
</div>

<style>
  .national-figures {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-6);
    margin: 0;
  }

  .figures__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  dt {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  dd {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .figures__value {
    font-size: 1.9rem;
    font-weight: var(--weight-black);
    line-height: 1.2;
  }

  .figures__source {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
</style>
