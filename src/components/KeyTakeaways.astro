---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<section class="panel stack takeaways" aria-labelledby="key-takeaways">
  <h2 id="key-takeaways" class="takeaways__title">Key takeaways</h2>
  <ul class="takeaways__list">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .takeaways__title {
    font-size: 1.3rem;
  }

  .takeaways__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: 22px;
  }
</style>
