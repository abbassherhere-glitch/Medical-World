---
/**
 * "Common questions" as expandable items. Works without JavaScript. The same
 * items are given to search engines as FAQPage structured data.
 */
import JsonLd from './JsonLd.astro';
import { faqPage } from '../lib/structured-data';
interface Props {
  id: string;
  heading: string;
  items: { question: string; answer: string }[];
}

const { id, heading, items } = Astro.props;
---

<JsonLd data={faqPage(items)} />
<section class="faq" aria-labelledby={id}>
  <h2 id={id} class="section-title faq__title">{heading}</h2>
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))
  }
</section>

<style>
  .faq__title {
    margin-bottom: var(--space-2);
  }

  .faq__item {
    border-top: 1px solid var(--color-border);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--tap-size);
    padding: var(--space-3) 0;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    font-size: 1.4rem;
    font-weight: var(--weight-regular);
    color: var(--color-accent);
  }

  details[open] summary::after {
    content: '\2212';
  }

  .faq__item p {
    padding-bottom: var(--space-4);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
