---
/**
 * A table that scrolls sideways inside its own box on small screens,
 * so the page itself never scrolls sideways. Put the <tr> rows in the slot.
 */
interface Props {
  caption: string;
  columns: string[];
  minWidth?: number;
}

const { caption, columns, minWidth = 520 } = Astro.props;
---

<div class="table-scroll" role="region" aria-label={caption} tabindex="0">
  <table style={`min-width: ${minWidth}px`}>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        {columns.map((column) => <th scope="col">{column}</th>)}
      </tr>
    </thead>
    <tbody>
      <slot />
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-md);
  }

  th {
    padding: 14px 18px;
    font-weight: var(--weight-bold);
    text-align: left;
    background: var(--color-light);
  }

  table :global(td),
  table :global(tbody th) {
    padding: 14px 18px;
    border-top: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  table :global(tbody th) {
    font-weight: var(--weight-regular);
  }

  /* Links in table cells get a full-height tap area without changing row height. */
  table :global(td a),
  table :global(tbody th a) {
    display: inline-block;
    margin-block: -12px;
    padding-block: 12px;
  }
</style>
