---
/**
 * Profession and state picker with a "Find schools" button.
 * Leave out `professions` to show the state list only (for side panels).
 */
import { STATES_AND_DC, slugify } from '../data/states';
import { isLive } from '../data/routes';

interface Props {
  /** A unique prefix for the field ids on this page. */
  id: string;
  professions?: { slug: string; name: string }[];
  /** Used when the profession list is not shown. */
  profession?: string;
  layout?: 'row' | 'column';
}

const { id, professions, profession, layout = 'row' } = Astro.props;

// Offer only states whose page is published, so the picker never leads to a
// missing page. (With more than one profession this uses the first one; the
// list will need to follow the chosen profession once a second one is added.)
const target = profession ?? professions?.[0]?.slug ?? '';
const states = (
  await Promise.all(STATES_AND_DC.map(async (name) => ({ name, slug: slugify(name), live: await isLive(`/${target}/${slugify(name)}/`) })))
).filter((state) => state.live);
---

<form
  class:list={['picker', `picker--${layout}`]}
  action="/schools/"
  method="get"
  data-state-picker
  data-profession={profession}
>
  {
    professions && (
      <div class="field picker__field">
        <label for={`${id}-profession`}>Profession</label>
        <select id={`${id}-profession`} name="profession" class="select">
          {professions.map((p) => (
            <option value={p.slug}>{p.name}</option>
          ))}
        </select>
      </div>
    )
  }
  {!professions && profession && <input type="hidden" name="profession" value={profession} />}
  <div class="field picker__field">
    <label for={`${id}-state`}>State</label>
    <select id={`${id}-state`} name="state" class="select" required>
      <option value="" selected disabled>Choose a state</option>
      {states.map((state) => <option value={state.slug}>{state.name}</option>)}
    </select>
  </div>
  <button type="submit" class="button button--action picker__button">Find schools</button>
</form>

<script>
  import '../scripts/state-picker';
</script>

<style>
  .picker {
    display: flex;
    gap: var(--space-3);
  }

  .picker--row {
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .picker--row .picker__field {
    flex: 1 1 170px;
  }

  .picker--row .picker__button {
    flex: 0 0 auto;
  }

  .picker--column {
    flex-direction: column;
  }

  @media (max-width: 480px) {
    .picker--row .picker__button {
      flex: 1 1 100%;
    }
  }
</style>
