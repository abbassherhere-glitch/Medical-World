---
/** The menu bar for one profession, shown under the site header on guide pages. */
import SmartLink from './SmartLink.astro';

interface Props {
  name: string;
  items: { key: string; label: string; href: string }[];
  active: string;
}

const { name, items, active } = Astro.props;
const menuId = 'profession-menu';
---

<div class="profession-bar">
  <nav class="container profession-nav" aria-label={`${name} guides`}>
    <span class="profession-nav__name">{name}</span>
    <button
      type="button"
      class="profession-nav__toggle"
      aria-expanded="false"
      aria-controls={menuId}
      data-menu-toggle
    >
      <span>{name} guides</span>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </button>
    <ul class="profession-nav__list" id={menuId} data-menu>
      {
        items.map((item) => (
          <li>
            <SmartLink href={item.href} aria-current={item.key === active ? 'page' : undefined}>
              {item.label}
            </SmartLink>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .profession-bar {
    background: var(--color-tint);
    border-bottom: 1px solid var(--color-border);
  }

  .profession-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-6);
    font-size: var(--text-sm);
  }

  .profession-nav__name {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--text-md);
    font-weight: var(--weight-black);
  }

  .profession-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    list-style: none;
    padding: 0;
  }

  .profession-nav__list :is(a, .link-pending) {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--color-text);
    text-decoration: none;
  }

  .profession-nav__list a:hover {
    color: var(--color-accent);
  }

  .profession-nav__list a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    box-shadow: inset 0 -3px 0 var(--color-accent);
  }

  .profession-nav__toggle {
    display: none;
  }

  @media (max-width: 767px) {
    :global(.js) .profession-nav__name {
      display: none;
    }

    :global(.js) .profession-nav__toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 48px;
      padding: 0;
      font-size: var(--text-md);
      font-weight: var(--weight-black);
      background: none;
      border: 0;
      cursor: pointer;
    }

    .profession-nav__toggle[aria-expanded='true'] svg {
      transform: rotate(180deg);
    }

    .profession-nav__list {
      flex-direction: column;
      width: 100%;
      padding-bottom: var(--space-2);
    }

    :global(.js) .profession-nav__list:not([data-open]) {
      display: none;
    }

    .profession-nav__list li + li {
      border-top: 1px solid var(--color-border);
    }

    .profession-nav__list :is(a, .link-pending) {
      display: flex;
      font-size: var(--text-base);
    }

    .profession-nav__list a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--color-accent);
      padding-left: var(--space-3);
    }
  }
</style>
