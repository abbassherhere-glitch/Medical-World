---
/** The grid of guide cards for a profession. */
import GuideCard from './GuideCard.astro';
import type { IconName } from './Icon.astro';
import { liveLinks } from '../data/routes';

interface Props {
  cards: { icon: IconName; title: string; text: string; linkText: string; href: string }[];
}

const { cards: allCards } = Astro.props;
// Only guides that exist are shown as cards.
const cards = await liveLinks(allCards);
---

<ul class="cards">
  {cards.map((card) => <li><GuideCard {...card} /></li>)}
</ul>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
    list-style: none;
    padding: 0;
  }

  .cards li {
    display: flex;
  }

  .cards li > :global(*) {
    flex: 1;
  }
</style>
