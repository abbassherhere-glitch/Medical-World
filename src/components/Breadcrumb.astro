---
/** Breadcrumb trail. The last item is the current page and is not a link. */
import { isLive } from '../data/routes';
import JsonLd from './JsonLd.astro';
import { breadcrumbList } from '../lib/structured-data';
import { siteOrigin } from '../settings';

interface Props {
  items: { label: string; href?: string }[];
}

const { items: allItems } = Astro.props;
// A step whose page does not exist yet is shown as text, never as a dead link.
const items = await Promise.all(
  allItems.map(async (item) => ({ ...item, href: item.href && (await isLive(item.href)) ? item.href : undefined })),
);
---

<JsonLd data={breadcrumbList(items.map((i) => ({ label: i.label, url: i.href ? new URL(i.href, siteOrigin()).href : undefined })))} />
<nav aria-label="Breadcrumb" class="breadcrumb" data-pagefind-ignore>
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index === items.length - 1 ? (
            <span aria-current="page">{item.label}</span>
          ) : item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span>{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .breadcrumb li + li::before {
    content: '/';
    padding: 0 0.5em;
    color: var(--color-text-secondary);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
  }

  .breadcrumb :is(a, span) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
  }
</style>
