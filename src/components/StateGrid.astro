---
/** A grid of state names that link to their pages once published. */
import { slugify } from '../data/states';
import { liveLinks } from '../data/routes';

interface Props {
  profession: string;
  states: readonly string[];
  /** Optional last item, for example a link to all states. */
  more?: { label: string; href: string };
  /** Optional section of each state page to link to, for example "licensing". */
  section?: string;
}

const { profession, states, more, section } = Astro.props;
// Only published state pages are listed.
const items = await liveLinks(
  states.map((state) => ({ label: state, href: `/${profession}/${slugify(state)}/${section ? `#${section}` : ''}` })),
);
const moreItem = more ? (await liveLinks([more]))[0] : undefined;
---

<ul class="state-grid">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
      </li>
    ))
  }
  {
    moreItem && (
      <li>
        <a class="state-grid__more" href={moreItem.href}>
          {moreItem.label}
        </a>
      </li>
    )
  }
</ul>

<style>
  .state-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: var(--space-1) var(--space-5);
    list-style: none;
    padding: 0;
  }

  .state-grid a {
    display: flex;
    align-items: center;
    min-height: 48px;
  }

  .state-grid__more {
    font-weight: var(--weight-bold);
  }
</style>
