---
/** Layout for simple text pages such as About and Privacy. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  lastUpdated?: string;
  indexable?: boolean;
  canonical?: boolean;
  breadcrumb?: boolean;
}

const { title, description, heading, lastUpdated, indexable, canonical, breadcrumb = true } = Astro.props;
---

<BaseLayout title={title} description={description} indexable={indexable} canonical={canonical}>
  <main id="main" class="container page" tabindex="-1">
    {breadcrumb && <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: heading }]} />}
    <h1>{heading}</h1>
    {lastUpdated && <p class="page__updated">Last updated {lastUpdated}.</p>}
    <div class="prose">
      <slot />
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-10);
  }

  .page:focus {
    outline: none;
  }

  .page__updated {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
