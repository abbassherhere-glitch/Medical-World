---
/** Layout for the site-wide index pages in the top menu, such as /salaries/. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
}

const { title, description, heading, intro } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main id="main" class="container hub" tabindex="-1">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: heading }]} />
    <h1>{heading}</h1>
    <p class="hub__intro">{intro}</p>
    <slot />
  </main>
</BaseLayout>

<style>
  .hub {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-10);
  }

  .hub:focus {
    outline: none;
  }

  .hub > :global(h1) {
    margin-top: calc(-1 * var(--space-4));
  }

  .hub__intro {
    max-width: 720px;
    font-size: var(--text-lead);
    color: var(--color-text-secondary);
  }

  .hub :global(.hub-section) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .hub :global(.hub-section__title) {
    font-size: 1.75rem;
  }

  .hub :global(.hub-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    list-style: none;
    padding: 0;
  }

  .hub :global(.hub-links a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
    font-weight: var(--weight-bold);
  }

  @media (max-width: 480px) {
    .hub :global(.hub-section) {
      padding: var(--space-5);
    }
  }
</style>
