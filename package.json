{
  "name": "healthcare-careers-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --silent",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "wording": "node scripts/check-wording.mjs",
    "verify": "npm run wording && npm run check && npm run lint && npm test && npm run build && npm run check-links && npm run check-area-text",
    "import-pay": "node scripts/import-pay/import.ts",
    "test": "node --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\"",
    "check-links": "node scripts/site/check-links.ts",
    "check-area-text": "node scripts/site/check-area-text.ts",
    "placeholders": "node scripts/site/placeholders.ts",
    "import-outlook": "node scripts/import-pay/import-outlook.ts",
    "import-schools": "node scripts/import-pay/import-schools.ts"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
